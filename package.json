{
  "name": "claude-code-ledger",
  "version": "0.4.0",
  "description": "Local-first cost & tool-call audit for Claude Code (plus Codex / Gemini CLI / Cursor logs): per-tool context cost, waste detection, CLAUDE.md suggestions, budget statusline, before/after compare, HTML report. Never reads your message content.",
  "type": "module",
  "bin": {
    "ccledger": "./bin/ccledger.js"
  },
  "files": [
    "bin",
    "src",
    "pricing.json",
    "scripts/demo-data.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/ccledger.js",
    "test": "node --test test/analyze.test.js test/features.test.js test/agents.test.js test/features2.test.js",
    "demo": "node scripts/demo-data.mjs /tmp/ccledger-demo && CCLEDGER_DIR=/tmp/ccledger-demo node bin/ccledger.js",
    "demo:gif": "node scripts/demo-data.mjs /tmp/ccledger-demo && node scripts/render-gif.mjs",
    "demo:pages": "node scripts/demo-data.mjs /tmp/ccledger-demo && node bin/ccledger.js report --dir /tmp/ccledger-demo --out docs/index.html"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "token",
    "cost",
    "usage",
    "audit",
    "tool-calls",
    "cli",
    "context",
    "waste",
    "hooks",
    "report",
    "codex",
    "gemini-cli",
    "cursor",
    "budget"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiqianha/claude-code-ledger"
  },
  "homepage": "https://caiqianha.github.io/claude-code-ledger/",
  "bugs": {
    "url": "https://github.com/caiqianha/claude-code-ledger/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}

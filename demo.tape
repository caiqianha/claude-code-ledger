# Render with: npm run demo:gif   (needs https://github.com/charmbracelet/vhs)
# The data is synthetic — generated by scripts/demo-data.mjs, nothing from a real session.
Output assets/demo.gif

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 14
Set Width 1360
Set Height 1000
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set Framerate 24
Env CCLEDGER_DIR "/tmp/ccledger-demo"

Hide
Type 'ccledger(){ __NODE__ __BIN__ "$@"; }; clear'
Enter
Sleep 500ms
Show

Type "ccledger --since 14d"
Sleep 400ms
Enter
Sleep 5s

Type "clear"
Enter
Type "ccledger waste --top 8"
Sleep 400ms
Enter
Sleep 5s

Type "clear"
Enter
Type "ccledger sessions --top 6"
Sleep 400ms
Enter
Sleep 4.5s
